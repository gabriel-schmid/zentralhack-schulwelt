  "dialogue": {
    "schreiner": {
      "intro": "Grüezi in der Werkstatt! Diese Woche bauen wir einen Hühnerstall für den Hof. Bevor du ein Werkzeug anfasst, schauen wir zusammen, was du dafür brauchst.",
      "hint": "Schutzausrüstung kommt immer vor dem Werkzeug.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "choice",
          "question": "Was ziehst du an, bevor du mit der Kreissäge arbeitest?",
          "options": [
            {
              "text": "Handschuhe und einen Schal",
              "correct": false
            },
            {
              "text": "Schutzbrille und Gehörschutz",
              "correct": true
            },
            {
              "text": "Nichts, es geht ja schnell",
              "correct": false
            }
          ]
        },
        {
          "type": "choice",
          "question": "Am Boden liegt ein Verlängerungskabel quer durch die Werkstatt. Was machst du?",
          "options": [
            {
              "text": "Ich steige einfach darüber.",
              "correct": false
            },
            {
              "text": "Ich ziehe den Stecker während jemand sägt.",
              "correct": false
            },
            {
              "text": "Ich lege es an den Rand und sichere es, damit niemand stolpert.",
              "correct": true
            }
          ]
        },
        {
          "type": "complete",
          "message": "Sehr gut. Handschuhe und lose Kleider können sich an der Säge verfangen, und ein Kabel am Boden ist eine Stolperfalle. Jetzt kannst du loslegen."
        }
      ]
    },
    "lea": {
      "intro": "Hoi! Ich plane den Hühnerstall. Heute zeichne ich, wie gross er wird und welche Bretter wir brauchen. Morgen sägen wir zusammen mit Herrn Bühler.",
      "hint": "Ein guter Plan spart Material und Zeit.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Heute Abend erzähle ich in der Aula, wie weit wir sind."
        }
      ]
    },
    "jonas": {
      "intro": "Ich wollte zuerst nur gamen, aber hier merke ich, wofür ich Mathe brauche: Ohne Winkel und Masse passt beim Stall nichts zusammen.",
      "hint": "Frag Herrn Bühler, bevor du die Säge benutzt.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Wieso lerne ich das? Hier sehe ich es."
        }
      ]
    }
  },
