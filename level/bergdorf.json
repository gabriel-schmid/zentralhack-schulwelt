  "dialogue": {
    "joel": {
      "intro": "Hoi, ich bin Joel! Hier lernt man auch in eigenen Projekten, ich mache eine Audiokarte über Treffpunkte im Dorf. Jeder Tag beginnt mit der Morgenrunde in der Aula, Tür Nummer eins. Die Nummern an den Türen führen dich durch den Vormittag.",
      "hint": "Die Tür ist vorne am Schulhaus, unter dem blauen Vordach.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Ich muss los, die Morgenrunde fängt gleich an. Wir sehen uns im Lernatelier, da rechne ich mit Lea."
        }
      ]
    }
  },
