  "dialogue": {
    "joel": {
      "intro": "Hoi, ich bin Joel! Hier lernt man auch in eigenen Projekten, ich mache eine Audiokarte über Treffpunkte im Dorf. Am Morgen Mathe, später Interviews draussen. Den ganzen Tag still sitzen muss hier niemand.",
      "hint": "Die Aula hat die Nummer eins, dort sind alle am Anfang des Tages.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "choice",
          "question": "Deinen Tag planst du drinnen am Tagesplan, Yara zeigt ihn dir in der Eingangshalle. Fix für alle ist zuerst die Morgenrunde in der Aula, Tür Nummer eins.",
          "options": [
            {
              "text": "Klingt gut, ich gehe rein.",
              "correct": true
            },
            {
              "text": "Und danach?",
              "correct": true
            }
          ]
        },
        {
          "type": "choice",
          "question": "Die Nummern an den Türen führen dich durch den Vormittag. Wo beginnt der Tag für alle?",
          "options": [
            {
              "text": "Hier draussen auf dem Dorfplatz",
              "correct": false
            },
            {
              "text": "In der Morgenrunde in der Aula, Tür ①",
              "correct": true
            },
            {
              "text": "Wann und wo man will, es gibt keinen Start",
              "correct": false
            }
          ]
        },
        {
          "type": "complete",
          "message": "Genau! Die Tür ist vorne am Schulhaus, unter dem blauen Vordach. Ich muss los, die Morgenrunde fängt gleich an. Wir sehen uns im Lernatelier, da rechne ich mit Lea."
        }
      ]
    }
  },
