  "dialogue": {
    "lehrerin": {
      "intro": "Guten Morgen und willkommen im Bergdorf! Jeden Morgen treffen wir uns hier im Forum: Ich sage, was heute ansteht, und ihr erzählt, was ihr euch vornehmt. Am Abend kommen wir wieder zusammen und teilen unsere Highlights.",
      "hint": "Schau dir die Orte im Dorf an. Jeder Ort hat sein eigenes Projekt.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "choice",
          "question": "Was passiert am Abend im Forum?",
          "options": [
            {
              "text": "Wir erzählen, was wir erreicht haben, und teilen unsere Highlights.",
              "correct": true
            },
            {
              "text": "Wir schreiben eine Prüfung.",
              "correct": false
            },
            {
              "text": "Nichts, der Tag endet in den Werkstätten.",
              "correct": false
            }
          ]
        },
        {
          "type": "complete",
          "message": "Genau. So weiss jede und jeder, was die anderen gelernt haben."
        }
      ]
    },
    "lea": {
      "intro": "Hoi! Ich baue diese Woche mit Noah ein Hochbeet. Heute plane ich zuerst, welches Holz wir brauchen.",
      "hint": "Im Lernatelier kannst du deinen eigenen Wochenplan machen.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Bis heute Abend im Forum!"
        }
      ]
    },
    "noah": {
      "intro": "Ich gehe heute in den Workshop von Frau Keller. Sie zeigt, wie man ein Projekt richtig plant.",
      "hint": "Die Workshops sind freiwillig. Du wählst selbst, was dich interessiert.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Komm doch auch mit in den Workshop-Saal!"
        }
      ]
    },
    "mia": {
      "intro": "Ich habe heute ein 1:1 mit dem Coach. Wir schauen, ob ich meine Ziele von letzter Woche erreicht habe.",
      "hint": "Den Coach findest du beim Coaching-Raum.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Ein 1:1 hilft mir, dranzubleiben."
        }
      ]
    },
    "coach": {
      "intro": "Hallo, ich bin Sandro, dein Coach. Erzähl mir, woran du gerade arbeitest, oder sag mir, wo du nicht weiterkommst.",
      "isGenius": true,
      "geniusSystemPrompt": "Du bist Sandro, Coach im Bergdorf, einer Schule, in der man in echten Projekten lernt. Du führst 1:1-Gespräche mit Lernenden. Antworte immer auf Deutsch in Schweizer Schreibweise (ss statt ß), kurz, freundlich und auf Augenhöhe. Hilf, eigene Ziele zu setzen und den nächsten Schritt zu finden; gib keine fertigen Lösungen, sondern stelle gute Fragen. Du kennst die Grundsätze der Schule: Raum für eigene Interessen in einer klaren Struktur, Lernen in echten Projekten, Mindestanforderungen und Verbindlichkeit, regelmässiges Feedback. Bei Projekten mit Werkzeug, Tieren oder in der Küche denkst du an die Sicherheit und fragst nach, wenn etwas fehlt; du ersetzt keine Instruktion durch eine Fachperson. Am Ende fasst du in zwei Sätzen zusammen, was sich die Person vorgenommen hat."
    },
    "koechin": {
      "intro": "Willkommen in der Küche! Heute kochen wir zusammen das Mittagessen für alle.",
      "hint": "Ein Messer legst du immer mit der Klinge vom Rand weg ab.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "choice",
          "question": "Was machst du zuerst, bevor du mit Lebensmitteln arbeitest?",
          "options": [
            {
              "text": "Hände waschen",
              "correct": true
            },
            {
              "text": "Den Herd einschalten",
              "correct": false
            },
            {
              "text": "Das Messer schleifen",
              "correct": false
            }
          ]
        },
        {
          "type": "complete",
          "message": "Genau, Hygiene kommt zuerst."
        }
      ]
