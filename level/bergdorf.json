  "dialogue": {
    "hauswart": {
      "intro": "Grüezi im Bergdorf! Im Schulhaus trifft sich die ganze Klasse am Morgen und am Abend in der Aula. Drinnen findest du auch das Lernatelier, den Coaching-Raum und die Workshops.",
      "hint": "Die Tür ist vorne am Schulhaus. Draussen gibt es die Werkstatt, die Küche und den Garten.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Viel Spass beim Entdecken!"
        }
      ]
    },
    "jana": {
      "intro": "Hoi! Ich gehe nach der Morgenrunde in den Garten. Heute pflanzen wir Salat für die Küche.",
      "hint": "Jedes Projekt im Dorf braucht etwas, das wir wirklich brauchen.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "complete",
          "message": "Bis heute Abend in der Aula!"
        }
      ]
    },
    "koechin": {
      "intro": "Willkommen in der Küche! Heute kochen wir zusammen das Mittagessen für alle.",
      "hint": "Ein Messer legst du immer mit der Klinge vom Rand weg ab.",
      "phases": [
        {
          "type": "intro"
        },
        {
          "type": "choice",
          "question": "Was machst du zuerst, bevor du mit Lebensmitteln arbeitest?",
          "options": [
            {
              "text": "Hände waschen",
              "correct": true
            },
            {
              "text": "Den Herd einschalten",
              "correct": false
            },
            {
              "text": "Das Messer schleifen",
              "correct": false
            }
          ]
        },
        {
          "type": "complete",
          "message": "Genau, Hygiene kommt zuerst."
        }
      ]
    }
  },
