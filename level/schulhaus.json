 "dialogue": {
  "lehrerin": {
   "intro": "Guten Morgen! Hier in der Aula treffen wir uns jeden Morgen: Ich sage, was heute ansteht, und ihr erzählt, was ihr euch vornehmt. Am Abend kommen wir wieder hier zusammen und teilen unsere Highlights.",
   "hint": "Im Coaching-Raum planst du mit Sandro deine Ziele.",
   "phases": [
    {
     "type": "intro"
    },
    {
     "type": "choice",
     "question": "Was passiert am Abend in der Aula?",
     "options": [
      {
       "text": "Wir erzählen, was wir erreicht haben, und teilen unsere Highlights.",
       "correct": true
      },
      {
       "text": "Wir schreiben eine Prüfung.",
       "correct": false
      },
      {
       "text": "Nichts, der Tag endet in den Werkstätten.",
       "correct": false
      }
     ]
    },
    {
     "type": "complete",
     "message": "Genau. So weiss jede und jeder, was die anderen gelernt haben."
    }
   ]
  },
  "lea": {
   "intro": "Hoi! Heute erzähle ich in der Morgenrunde, dass wir mit dem Hühnerstall anfangen.",
   "hint": "Die Werkstatt ist draussen im Dorf.",
   "phases": [
    {
     "type": "intro"
    },
    {
     "type": "complete",
     "message": "Bis heute Abend hier in der Aula!"
    }
   ]
  },
  "noah": {
   "intro": "Ich gehe nach der Morgenrunde in den Workshop von Frau Keller. Sie zeigt, wie man ein Projekt plant.",
   "hint": "Die Workshops sind freiwillig. Du wählst selbst, was dich interessiert.",
   "phases": [
    {
     "type": "intro"
    },
    {
     "type": "complete",
     "message": "Der Workshop-Raum ist hinten rechts."
    }
   ]
  },
  "mia": {
   "intro": "Im Lernatelier mache ich meinen Wochenplan. Mathe habe ich schon fertig, jetzt arbeite ich an meinem Interessensprojekt über Bienen.",
   "hint": "Mindestanforderungen zuerst, dann bleibt Zeit für eigene Projekte.",
   "phases": [
    {
     "type": "intro"
    },
    {
     "type": "complete",
     "message": "Am Freitag bespreche ich alles im 1:1."
    }
   ]
  },
  "coach": {
   "intro": "Hallo, ich bin Sandro, dein Coach. Erzähl mir, woran du gerade arbeitest, oder sag mir, wo du nicht weiterkommst.",
   "isGenius": true,
   "geniusSystemPrompt": "Du bist Sandro, Coach im Bergdorf, einer Schule, in der man in echten Projekten lernt. Du führst 1:1-Gespräche mit Lernenden. Antworte immer auf Deutsch in Schweizer Schreibweise (ss statt ß), kurz, freundlich und auf Augenhöhe. Hilf, eigene Ziele zu setzen und den nächsten Schritt zu finden; gib keine fertigen Lösungen, sondern stelle gute Fragen. Du kennst die Grundsätze der Schule: Raum für eigene Interessen in einer klaren Struktur, Lernen in echten Projekten, Mindestanforderungen und Verbindlichkeit, regelmässiges Feedback. Bei Projekten mit Werkzeug, Tieren oder in der Küche denkst du an die Sicherheit und fragst nach, wenn etwas fehlt; du ersetzt keine Instruktion durch eine Fachperson. Am Ende fasst du in zwei Sätzen zusammen, was sich die Person vorgenommen hat."
  },
  "workshop": {
   "intro": "Hallo! Ich bin Frau Keller und leite die Workshops. Diese Woche geht es darum, wie man ein Projekt plant: Ziel, Schritte, Material und Zeit.",
   "hint": "Die Workshops sind freiwillig und finden während der Woche statt.",
   "phases": [
    {
     "type": "intro"
    },
    {
     "type": "choice",
     "question": "Womit beginnt eine gute Projektplanung?",
     "options": [
      {
       "text": "Mit einem klaren Ziel",
       "correct": true
      },
      {
       "text": "Mit dem Einkaufen des Materials",
       "correct": false
      },
      {
       "text": "Mit dem Bauen, planen kann man später",
       "correct": false
      }
     ]
    },
    {
     "type": "complete",
     "message": "Genau. Wer das Ziel kennt, kann die Schritte planen."
    }
   ]
  }
 },
 "i18n": {}
